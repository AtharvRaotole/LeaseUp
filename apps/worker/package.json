{
  "name": "@leaseup/worker",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node ../../scripts/generate-tracked-brands.mjs && node ../../scripts/generate-brand-display.mjs && node ../../scripts/build-geotiles.mjs && tsc",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@leaseup/contracts": "workspace:*",
    "@leaseup/fixtures": "workspace:*",
    "hono": "^4.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250117.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "glob": "^13.0.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.102.0"
  }
}
