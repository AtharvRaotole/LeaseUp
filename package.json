{
  "name": "leaseup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:ci": "pnpm lint && pnpm typecheck && pnpm test && VITE_API_URL=https://ci.leaseup.invalid pnpm build && node scripts/check-bundle-dashes.mjs && node scripts/check-worker-bundle.mjs && node scripts/worker-analyze-smoke.mjs",
    "screenshots": "node scripts/ui-snapshots.mjs",
    "screenshots:features": "node scripts/feature-screenshots.mjs",
    "test:e2e": "pnpm --filter @leaseup/worker exec wrangler d1 execute leaseup_db --local --file=schema.sql && playwright test",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:screenshots": "node scripts/brand-screenshots.mjs",
    "story:screenshots": "node scripts/story-screenshots.mjs",
    "record:demo": "node scripts/run-record-demo.mjs",
    "record:demo:local": "node scripts/run-record-demo.mjs",
    "record:demo:script": "node scripts/record-demo.mjs",
    "capture:devpost": "node scripts/run-capture-devpost.mjs",
    "capture:devpost:local": "node scripts/run-capture-devpost.mjs",
    "capture:devpost:script": "node scripts/capture-devpost-screenshots.mjs",
    "eval:metros": "node scripts/eval-metros.mjs",
    "qa:address-sweep": "node scripts/qa/address-sweep.mjs",
    "lighthouse:ci": "node scripts/run-lighthouse-ci.mjs",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:csp": "node scripts/run-csp-e2e.mjs",
    "deploy": "pnpm --filter @leaseup/worker deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.49.1",
    "png-to-ico": "^3.0.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite-plugin-compression": "^0.5.1"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  }
}
