{
  "name": "leaseup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-bundle-dashes.mjs",
    "screenshots": "node scripts/ui-snapshots.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:screenshots": "node scripts/brand-screenshots.mjs",
    "deploy": "pnpm --filter @leaseup/worker deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "^1.49.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  }
}
